[Unit]
Description=PRIMEVPN Service
After=network.target
Wants=network.target

[Service]
EnvironmentFile=-/etc/conf.d/PRIMEVPN
Environment="XRAY_VMESS_AEAD_FORCED=false"
Type=simple
WorkingDirectory=/usr/local/PRIMEVPN/
ExecStart=/usr/local/PRIMEVPN/PRIMEVPN
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
